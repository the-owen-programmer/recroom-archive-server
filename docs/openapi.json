        ],
        "summary": "Several rooms by id and/or name (`?id=1&id=2&name=X`); unknown ones are left out.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
