{
  "openapi": "3.0.4",
  "info": {
    "title": "Fake Rec Room backend",
    "description": "Re-implementation of the RecNet services the Rec Room client talks to, reconstructed from the client's own code and from the requests it makes. Every *.rec.net host is served by this one process; the 'Host' column in each endpoint says which service name the client uses.",
    "version": "v1"
  },
  "paths": {
    "/account/bulk": {
      "get": {
        "tags": [
          "Accounts (accounts.rec.net)"
        ],
        "summary": "Several accounts by id, query `?id=1&id=2`. Unknown ids are skipped.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/account/me": {
      "get": {
        "tags": [
          "Accounts (accounts.rec.net)"
        ],
        "summary": "The logged-in account.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/account/{id}": {
      "get": {
        "tags": [
          "Accounts (accounts.rec.net)"
        ],
        "summary": "One account by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/cachedlogin/forplatformid/{platform}/{platformId}": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "Cached logins for one platform account (platform 0 = Steam). The local player is returned for any id,\n            so the fake Steam ticket never has to be verified.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/cachedlogin/forplatformids": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "Cached logins for several platform ids at once.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/cachedlogin/current": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "The cached login of the current device.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/eac/challenge": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "Easy Anti-Cheat handshake: the client asks for a challenge before logging in.",
        "description": "Verified shape: a bare JSON string (`\"AAAAAAAAAAAAAAAAAAAAAA==\"`). An object (`{\"Challenge\":..}`, `{\"challenge\":..}`)\ngives \"Malformed Response\" and login error code `challenge`; the bare string moves the failure on to code `wrapper`\n(the EAC native wrapper, which is not available in the archive build: \"EAC runtime inactive\").",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/{path}": {
      "get": {
        "tags": [
          "CDN (cdn.rec.net)"
        ],
        "summary": "A blob by path (e.g. `/room/<blob name>`).",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Third-party: Unity cloud"
        ],
        "summary": "Accept any Unity cloud POST/GET with an empty JSON object.",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
