{
  "openapi": "3.0.4",
  "info": {
    "title": "Fake Rec Room backend",
    "description": "Re-implementation of the RecNet services the Rec Room client talks to, reconstructed from the client's own code and from the requests it makes. Every *.rec.net host is served by this one process; the 'Host' column in each endpoint says which service name the client uses.",
    "version": "v1"
  },
  "paths": {
    "/cachedlogin/forplatformid/{platform}/{platformId}": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "Cached logins for one platform account (platform 0 = Steam). The local player is returned for any id,\n            so the fake Steam ticket never has to be verified.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/cachedlogin/forplatformids": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "Cached logins for several platform ids at once.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/cachedlogin/current": {
      "get": {
        "tags": [
          "Auth (auth.rec.net)"
        ],
        "summary": "The cached login of the current device.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/generate_204": {
      "get": {
        "tags": [
          "Connectivity (google.com)"
        ],
        "summary": "Internet reachability probe. Must answer 204 No Content.",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Connectivity (google.com)"
        ],
        "summary": "Plain 200 for the bare host (the client also references `https://google.com`).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "head": {
        "tags": [
          "Connectivity (google.com)"
        ],
        "summary": "Plain 200 for the bare host (the client also references `https://google.com`).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/_debug/requests": {
      "get": {
        "tags": [
          "Debug"
        ],
        "summary": "The most recent requests the server saw (also appended to logs/requests.jsonl).",
        "parameters": [
          {
            "name": "take",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LoggedRequest"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LoggedRequest"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LoggedRequest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/avatar/v1/defaultunlocked": {
      "get": {
        "tags": [
          "Econ (econ.rec.net)"
        ],
        "summary": "Avatar items every player owns by default. Empty for now (the client keeps its built-in defaults).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/api/gameconfigs/v1/all": {
      "get": {
        "tags": [
          "GameConfigs (api.rec.net)"
        ],
        "summary": "All game configs. Client type `RecNet.GameConfig`: Key, Value, ActiveExperiments, StartTime, EndTime.",
        "description": "An empty list means every setting falls back to the value compiled into the client.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { }
                }
              }
            }
          }
        }
      }
    },
    "/{path}": {
      "get": {
        "tags": [
          "NameServer (ns.rec.net)"
        ],
        "summary": "List the base URL of every RecNet service.",
        "description": "The client logs \"RecNet name server query failed\" and \"Failed to connect to RecNet (error code: summer)\" when this\ndoes not answer. The exact path the client requests is not known yet, so every GET on this host returns the table;\ncheck `logs/requests.jsonl` for what the client really sends.",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NameServerResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NameServerResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NameServerResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Third-party: Unity cloud"
        ],
        "summary": "Accept any Unity cloud POST/GET with an empty JSON object.",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/{call}": {
      "post": {
        "tags": [
          "Third-party: RudderStack"
        ],
        "summary": "Accept any analytics call (track, identify, batch, webhook).",
        "parameters": [
          {
            "name": "call",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/initialize": {
      "post": {
        "tags": [
          "Third-party: Statsig (statsigapi.net)"
        ],
        "summary": "Statsig SDK initialisation: the client's feature gates, dynamic configs and layers.",
        "description": "Empty (\"everything off / default\") config. The client also logs \"Detected change in CdnKey from statsig\", so a dynamic config\nnamed after the CDN key may be needed later; the request body (user, statsigMetadata) is logged by the request log.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/log_event": {
      "post": {
        "tags": [
          "Third-party: Statsig (statsigapi.net)"
        ],
        "summary": "Statsig event upload.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/versioncheck/v4": {
      "get": {
        "tags": [
          "VersionCheck (api.rec.net)"
        ],
        "summary": "Is this client version allowed to play? Client query: `?v=20240815.01&p=0&pid=0`.",
        "description": "Client type `RecNet.VersionCheck.VersionCheckResponse`. `VersionStatus`: 0 ValidForPlay, 1 UpdateRequired.\n`UpdateNotificationStage`: 0 None, 1 Silent, 2 Warn, 3 Prompt, 4 Require. Always valid: the archived build is the only one.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/versioncheck/islandedversions": {
      "get": {
        "tags": [
          "VersionCheck (api.rec.net)"
        ],
        "summary": "Versions that are \"islanded\" (kept apart from the main population). None.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoggedRequest": {
        "type": "object",
        "properties": {
          "Time": {
            "type": "string",
            "format": "date-time"
          },
          "Host": {
            "type": "string",
            "nullable": true
          },
          "Method": {
            "type": "string",
            "nullable": true
          },
          "Path": {
            "type": "string",
            "nullable": true
          },
          "Query": {
            "type": "string",
            "nullable": true
          },
          "ContentType": {
            "type": "string",
            "nullable": true
          },
          "UserAgent": {
            "type": "string",
            "nullable": true
          },
          "Headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "Body": {
            "type": "string",
            "nullable": true
          },
          "Status": {
            "type": "integer",
            "format": "int32"
          },
          "Handled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "One request seen by the server (kept in memory and appended to requests.jsonl)."
      },
      "NameServerResponse": {
        "type": "object",
        "properties": {
          "RecNetStatus": {
