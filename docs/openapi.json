            "nullable": true
          },
          "Rooms": {
            "type": "string",
            "nullable": true
          },
          "PlatformNotifications": {
            "type": "string",
            "nullable": true
          },
          "Moderation": {
            "type": "string",
            "nullable": true
          },
          "DataCollection": {
            "type": "string",
            "nullable": true
          },
          "BugReporting": {
            "type": "string",
            "nullable": true
          },
          "Discovery": {
            "type": "string",
            "nullable": true
          },
          "PlayerSettings": {
